{
    "name": "maukirim/sdk",
    "description": "Official PHP SDK for MauKirim - managed WhatsApp gateway for OTP, templated notifications, rented numbers and webhooks.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://maukirim.com",
    "keywords": [
        "maukirim",
        "whatsapp",
        "otp",
        "notification",
        "gateway",
        "sdk"
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "MauKirim\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauKirim\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
